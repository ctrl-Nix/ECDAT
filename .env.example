# Copy to .env and supply values through an approved secret-management workflow.
# Never commit the populated .env file, certificates, private keys, or report bundles.
POSTGRES_USER=ecdat
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=ecdat
POSTGRES_HOST=db
POSTGRES_PORT=5432

# The backend uses this only for non-browser transitional API protection.
# It must be a long random value in a secret store; never expose it to a browser.
API_KEY=replace-with-a-long-random-api-key
DEBUG=false
# Same-origin gateway deployment requires no CORS. Use an explicit JSON list
# only for an approved separate browser origin.
CORS_ORIGINS=[]

# Private local Compose database only. Use verify-full plus POSTGRES_SSL_ROOT_CERT
# when connecting to a remote managed PostgreSQL service.
POSTGRES_SSL_MODE=disable
POSTGRES_SSL_ROOT_CERT=

ENABLE_LOCAL_SCAN_API=false
ALLOW_REMOTE_REMEDIATION=false
REPORT_SYNC_REQUIRE_MTLS=true
REPORT_SYNC_MTLS_HEADER=X-ECDAT-mTLS-Verified
REPORT_SYNC_MAX_BUNDLE_BYTES=1048576
SCAN_MIN_CONFIDENCE_BAND=PROBABLE


# JSON object mapping provisioned agent IDs to base64-encoded raw Ed25519 public keys.
# Example: {"build-agent-01":"base64-raw-ed25519-public-key"}
REPORT_SYNC_AGENT_KEYS={}

# The agent-ingestion TLS hostname is configured in deploy/nginx/nginx.conf as
# agent.ecdat.local. Replace it with an organization-owned hostname before use.
# Host port for the TLS gateway. Use 443 only when the host/network policy permits it.
ECDAT_HTTPS_PORT=8443
