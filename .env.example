# Copy this file to .env and fill in real values locally.
# .env itself must NEVER be committed — see .gitignore and .clinerules rule 6.
# DATABASE_URL is auto-constructed from POSTGRES_* variables below.

POSTGRES_USER=ctrlnix
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=crypto_discovery
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Only needed by whoever is calling the remediation LLM (Shreyanshi)
NVIDIA_BUILD_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_API_KEY=your_key_here
API_KEY=
DEBUG=true